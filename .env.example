# ==============================================================================
# Rubik Integrated Systems (DEP1) — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development or configure public build-time
# values via GitHub Repository Variables (Settings -> Secrets and variables).
# NEVER store private API secrets or SMTP passwords in `VITE_*` variables,
# because Vite inlines `VITE_*` values into the public browser bundle.

# Public base path for Vite & React Router.
# - Use `/` for a custom domain (e.g. https://www.rubik-is.com/) or user/org Pages repo.
# - Use `/<repo-name>/` for a GitHub Pages project site (auto-set in deploy.yml).
VITE_BASE_PATH=/

# Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Loaded ONLY after explicit visitor opt-in via CookieConsentBanner (Consent Mode v2).
VITE_GA_MEASUREMENT_ID=

# Optional Google Tag Manager Container ID (e.g. GTM-XXXXXXX)
VITE_GTM_ID=

# Optional external form-relay endpoint for static GitHub Pages deployments
# (e.g. Formspree or an external serverless API URL).
# If unset on GitHub Pages, the Contact form gracefully falls back to
# `mailto:info@rubik-is.com` and `+20 100 101 0538`.
VITE_CONTACT_ENDPOINT=
